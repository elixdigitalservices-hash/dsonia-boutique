{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    { "source": "/FOTOS/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/panel.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "redirects": [
    { "source": "/panel", "destination": "/panel.html", "permanent": false }
  ]
}
